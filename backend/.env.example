# ==============================================================================
# PROYECTO SOFÍA - CONFIGURACIÓN DEL ENTORNO
# ==============================================================================

# Entorno de ejecución (development / staging / production)
ENVIRONMENT=development
DEBUG=True

# Configuración del Servidor API
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Configuración de Base de Datos MySQL
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_sofia

# Configuración de Redis (Caché, Rate Limiting y WebSockets)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=True

# Seguridad y Criptografía JWT
SECRET_KEY=sofia_super_secret_jwt_key_2026_tiktok_clone_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
SECURITY_HEADERS_ENABLED=True

# Limitador de Tasa (Rate Limiting)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_PER_MINUTE=10/minute
RATE_LIMIT_REGISTER_PER_MINUTE=5/minute
RATE_LIMIT_PIN_PER_MINUTE=5/minute
RATE_LIMIT_UPLOAD_PER_MINUTE=10/minute

# Almacenamiento Multimedia (local o s3)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=["mp4","mov","webm","avi"]
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp"]

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=proyecto-sofia-media
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Parámetros de Control Parental por Defecto
DEFAULT_SCREEN_TIME_LIMIT_MINS=120
DEFAULT_CURFEW_START=22:00
DEFAULT_CURFEW_END=06:00
